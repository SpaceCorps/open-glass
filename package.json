{
  "name": "open-glass-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fmt": "vp check --no-lint --fix",
    "lint": "vp check --no-fmt",
    "test": "pnpm -r --parallel test",
    "test:core": "cargo test --workspace",
    "clippy": "cargo clippy --workspace -- -D warnings",
    "build:wasm": "pnpm --filter @open-glass/core build:wasm",
    "build": "pnpm run build:wasm && pnpm run build:core && pnpm -r --filter=!@open-glass/core build",
    "build:core": "pnpm --filter @open-glass/core build",
    "dev": "pnpm --filter storybook dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
